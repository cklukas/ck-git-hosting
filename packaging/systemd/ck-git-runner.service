# A remote CI runner: runs CI jobs for a main ck-git host it reaches over SSH
# with its own restricted runner key (see docs/operations/ci-remote-runners.md).
# It runs as the unprivileged ckgit-runner account, keeps nothing between jobs
# (its build root is emptied at start-up and after every job), and needs the
# same unprivileged user, mount, and network namespaces as the server's own
# runner to confine each step. It is installed disabled; `ck-git-runner
# register` writes /etc/ck-git-hosting/runner.ini, then enable it:
#   systemctl enable --now ck-git-runner.service

[Unit]
Description=ck-git-hosting remote CI runner
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/ck-git-hosting/runner.ini

[Service]
Type=simple
User=ckgit-runner
Group=ckgit-runner
ExecStart=/usr/lib/ck-git-runner/ck-ci-runnerd serve --remote --config /etc/ck-git-hosting/runner.ini
# A stop hands a job in progress back to the main host's queue, so another
# runner takes it at once instead of waiting for the lease to lapse.
KillSignal=SIGTERM
TimeoutStopSec=90s
Restart=always
RestartSec=10s
UMask=0077
Environment=HOME=/var/lib/ck-git-runner
Environment=LANG=C
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=GIT_CONFIG_GLOBAL=/dev/null

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# As for ck-ci-runner.service: not RestrictSUIDSGID, whose seccomp filter also
# refuses the mount API a step's own sandbox (bubblewrap) needs;
# NoNewPrivileges already makes set-user-ID files harmless.
RestrictSUIDSGID=no
RestrictNamespaces=user mnt net
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/ck-git-runner

[Install]
WantedBy=multi-user.target
