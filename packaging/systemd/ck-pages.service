#
# Hardened service for the ck-git-hosting Pages server. It serves published
# static sites from pages_root on pages_http_port — a distinct origin from the
# dashboard, deliberately LAN-exposable so the sites are browsable on the
# intranet. Because it serves arbitrary project-generated content it is a
# separate process from the control-plane daemon, with no control socket, no
# repository access, and no write access at all: it only reads pages_root.
# Firewall pages_http_port to the intended subnet.
#
# A fresh install sets pages_root but leaves pages_http_port commented out
# (see packaging/install.sh), so this unit is enabled by the installer and the
# package alike, the same as the other two. ExecCondition below is what keeps
# it correctly inactive rather than restart-looping until an administrator
# also sets pages_http_port and restarts it (D3/WP4): systemd treats a nonzero
# ExecCondition as "skip this activation", not a failed start, so Restart=
# never engages for it the way it would for a failing ExecStart.

[Unit]
Description=ck-git-hosting Pages server
After=network.target
ConditionPathExists=/etc/ck-git-hosting/server.ini

[Service]
Type=simple
User=ckgit
Group=ckgit
ExecCondition=/usr/bin/ck-pagesd check --config /etc/ck-git-hosting/server.ini
ExecStart=/usr/bin/ck-pagesd serve --config /etc/ck-git-hosting/server.ini
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0077
Environment=LANG=C

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The server only reads pages_root, so the filesystem stays read-only under
# ProtectSystem=strict, with one exception: a single runtime directory where it
# records its own version at startup (for the dashboard and `ckgit version`).
# The package's postinst pre-creates the directory before starting the service.
# No '-' prefix: systemd (Debian 13) silently drops a '-'-prefixed ReadWritePaths
# even when the path exists, which left pages unable to record its version.
ReadWritePaths=/var/lib/ck-git-hosting/state/runtime

[Install]
WantedBy=multi-user.target
