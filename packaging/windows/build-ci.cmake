# Native CI entry point: an operator-staged MSVC/SDK environment, CMake,
# NMake and Inno Setup must already be available inside the Windows job.
cmake_minimum_required(VERSION 3.24)
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "Windows installers must be built on Windows")
endif()
if("$ENV{TMPDIR}" STREQUAL "" OR NOT IS_ABSOLUTE "$ENV{TMPDIR}")
  message(FATAL_ERROR "Select an absolute job TMPDIR before building")
endif()
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(TO_CMAKE_PATH "$ENV{TMPDIR}" scratch)
set(build "${scratch}/ckgit-windows-build")
set(output "${source}/dist")
find_program(iscc NAMES ISCC.exe REQUIRED)
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(cpack NAMES cpack.exe HINTS "${cmake_bin}" REQUIRED)
file(READ "${source}/VERSION" version)
string(STRIP "${version}" version)
set(stamp "${version}+source")
if(NOT "$ENV{CKGIT_COMMIT}" STREQUAL "")
  string(SUBSTRING "$ENV{CKGIT_COMMIT}" 0 12 commit)
  set(stamp "${version}+g${commit}")
endif()
if("$ENV{CKGIT_REF}" MATCHES "^refs/tags/(.*)$")
  if(NOT CMAKE_MATCH_1 STREQUAL "v${version}")
    message(FATAL_ERROR "Release tag must match VERSION")
  endif()
  set(stamp "${stamp}.${CMAKE_MATCH_1}")
endif()
function(run)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${source}" RESULT_VARIABLE status)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Windows build command failed (${status}): ${ARGV}")
  endif()
endfunction()
function(fingerprint result)
  file(GLOB_RECURSE inputs RELATIVE "${source}" "${source}/src/*" "${source}/include/*" "${source}/packaging/*")
  list(APPEND inputs CMakeLists.txt VERSION LICENSE)
  list(SORT inputs)
  set(records "")
  foreach(input IN LISTS inputs)
    if(NOT IS_DIRECTORY "${source}/${input}")
      file(SHA256 "${source}/${input}" hash)
      string(APPEND records "${hash}  ${input}\n")
    endif()
  endforeach()
  set(${result} "${records}" PARENT_SCOPE)
endfunction()
# Each CI job owns its TMPDIR and starts a fresh build. Never reuse a previous
# job's output as an installer input.
file(REMOVE_RECURSE "${build}" "${output}")
file(MAKE_DIRECTORY "${output}")
fingerprint(inputs_before)
string(TIMESTAMP start "%s" UTC)
run("${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G "NMake Makefiles"
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_TRY_COMPILE_CONFIGURATION=Release -DBUILD_TESTING=OFF "-DCKGIT_BUILD_VERSION=${stamp}")
run("${CMAKE_COMMAND}" --build "${build}" --config Release)
fingerprint(inputs_after)
if(NOT inputs_before STREQUAL inputs_after)
  message(FATAL_ERROR "Source inputs changed during the Windows build")
endif()
foreach(product ckdocs ckgit ck-git-runner)
  set(executable "${product}")
  if(product STREQUAL "ck-git-runner")
    set(executable "ck-ci-runnerd")
  endif()
  run("${build}/bin/${executable}.exe" --version)
  run("${iscc}" "/DBinaryDir=${build}/bin" "/DOutputDir=${output}"
      "/DReleaseVersion=${version}" "${source}/packaging/windows/${product}.iss")
  if(NOT EXISTS "${output}/${product}-${version}-windows-x64-setup.exe")
    message(FATAL_ERROR "Installer missing for ${product}")
  endif()
endforeach()
run("${cpack}" --config "${build}/CPackConfig.cmake" -C Release -B "${output}")
string(TIMESTAMP end "%s" UTC)
math(EXPR elapsed "${end} - ${start}")
file(WRITE "${output}/windows-build-inputs.sha256" "${inputs_before}")
file(WRITE "${output}/windows-build.txt"
    "commit=$ENV{CKGIT_COMMIT}\nversion=${stamp}\nconfiguration=Release\ngenerator=NMake Makefiles\nstart_epoch=${start}\nend_epoch=${end}\nelapsed_seconds=${elapsed}\nbinary_directory=${build}/bin\n")
file(GLOB packages "${output}/*-setup.exe" "${output}/*.zip")
set(hashes "")
foreach(package IN LISTS packages)
  file(SHA256 "${package}" hash)
  get_filename_component(name "${package}" NAME)
  string(APPEND hashes "${hash}  ${name}\n")
endforeach()
file(WRITE "${output}/windows-packages.sha256" "${hashes}")
message(STATUS "Windows installers and portable ZIP are ready in ${output} (${elapsed}s)")
