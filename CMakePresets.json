{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (MSVC and Ninja)",
      "generator": "Ninja",
      "binaryDir": "$env{TMPDIR}/ckgit-ninja-release",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "notEquals",
            "lhs": "$env{TMPDIR}",
            "rhs": ""
          }
        ]
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TRY_COMPILE_CONFIGURATION": "Release",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "windows-lpac-release",
      "displayName": "Windows LPAC Release (MSVC and NMake)",
      "inherits": "windows-release",
      "generator": "NMake Makefiles",
      "binaryDir": "$env{TMPDIR}/ckgit-lpac-release"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
