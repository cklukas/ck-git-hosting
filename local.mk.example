#
# Copy this file to local.mk (gitignored, never committed) to pin a default
# BUILD_ROOT for this particular checkout, instead of the portable default
# (TMPDIR, or /tmp when TMPDIR is unset) or typing BUILD_ROOT= on every
# invocation. Makefile does `-include local.mk` before applying its own
# `BUILD_ROOT ?=` default, so a value set here wins.
#
#   cp local.mk.example local.mk
#   edit local.mk to taste
#
# Example: keep build products off a network-mounted source volume. Several
# approved roots may be listed, separated by spaces; BUILD_DIR may then be
# beneath any of them.
#BUILD_ROOT := /Volumes/S8T/tmp /Volumes/PRO-BLADE/tmp
